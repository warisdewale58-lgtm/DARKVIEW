{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "headers": [
    { "source": "/data.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
